# TOKEN TELEGRAM
TELEGRAM_TOKEN=123456789:ABCDEF

# OPENAI
OPENAI_API_KEY=sk-...

# QDRANT
QDRANT_URL=https://xxxx.europe-west3-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=...

# Nomi collection
QDRANT_COLLECTION=iris_memory
QDRANT_CHAT_COLLECTION=iris_chat_history

# URL pubblico Render per webhook
PUBLIC_URL=https://telegram-tts.onrender.com

# Modalità IRIS: HYBRID | RAG | BASE
IRIS_MODE=HYBRID
PORT=10000

